# PostgreSQL connection string (Neon or another hosted PostgreSQL provider)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# For local Postgres started by `npm run db:local` instead:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres

# Use a long, private random value. Changing it invalidates existing login tokens.
JWT_SECRET=replace-with-a-long-random-secret

# Required only for the first-run POST /auth/setup flow.
SETUP_CODE=replace-with-a-private-one-time-setup-code

PORT=4000

# Comma-separated browser origins. `*` is convenient for local development only.
# Example production values: https://admin.example.com,https://pos.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Optional: serve a built web frontend from this backend. Leave unset when hosting
# the React frontend separately.
# POTKO_WEB_DIR=../web/dist
